# ============================================================
# p1228 environment variables (example)
# Copy this file to ".env" and fill in the real values.
# NEVER commit real tokens. ".env" is git-ignored.
# ============================================================

# ---- Bot tokens (one Discord application per bot) ----

# 星燈 (general: server features and administration commands)
P1228_GENERAL_TOKEN=
# 言ノ葉 (read-aloud A)
P1228_READ_ALOUD_A_TOKEN=
# 紡言 (read-aloud B)
P1228_READ_ALOUD_B_TOKEN=

# ---- Storage ----

# Path of the SQLite database file. The rebuilt implementation reads
# the existing production database as-is (schema migrations 001-004).
# P1228_DB_PATH=data/p1228.sqlite3

# ---- Read-aloud (VOICEVOX-compatible engine) ----

# Base URL of the VOICEVOX ENGINE compatible HTTP API.
# VOICEVOX_BASE_URL=http://127.0.0.1:50021

# Audio cache directory and limits.
# P1228_AUDIO_CACHE_DIR=data/audio-cache
# P1228_AUDIO_CACHE_MAX_MB=512
# P1228_AUDIO_CACHE_TTL_HOURS=24

# ---- /ai (llama.cpp llama-server, OpenAI-compatible API) ----

# LLAMA_BASE_URL=http://127.0.0.1:8080

# ---- Alerts (optional) ----

# Discord webhook for storage-monitor alerts. Leave unset to disable.
# P1228_ALERT_WEBHOOK_URL=
